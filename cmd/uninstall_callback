#!/bin/bash

### 卸载后：根据用户选择处理数据
set -e

# 用户选择：wizard_data_action=delete 删除，其他值保留
ACTION="${wizard_data_action:-keep}"

if [ "$ACTION" = "delete" ]; then
  # 删除数据库（共享数据目录）
  if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
    IFS=':' read -ra PATHS <<< "$TRIM_DATA_SHARE_PATHS"
    for p in "${PATHS[@]}"; do
      if [ -d "$p" ]; then
        rm -f "$p/shuatixia.db" "$p/shuatixia.db-wal" "$p/shuatixia.db-shm" 2>/dev/null || true
      fi
    done
  fi

  # 删除默认数据目录
  if [ -d "$TRIM_PKGVAR/data" ]; then
    rm -rf "$TRIM_PKGVAR/data" 2>/dev/null || true
  fi
fi

exit 0